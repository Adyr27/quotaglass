{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The only window. Events, window dragging and the app's own commands. No fs, shell, http or opener access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "allow-get-snapshot",
    "allow-refresh-now",
    "allow-detect",
    "allow-get-settings",
    "allow-update-settings",
    "allow-connect",
    "allow-add-account",
    "allow-open-cli",
    "allow-remove-account",
    "allow-set-hidden",
    "allow-set-pinned",
    "allow-set-label",
    "allow-connect-source",
    "allow-open-url",
    "allow-set-panel-open"
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The pill and the flyout. Events, window dragging and the app's own commands. No fs, shell, http or opener access.",
  "windows": [
    "main",
    "flyout"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "allow-get-snapshot",
    "allow-refresh-now",
    "allow-detect",
    "allow-get-settings",
    "allow-update-settings",
    "allow-connect",
    "allow-add-account",
    "allow-open-cli",
    "allow-remove-account",
    "allow-set-hidden",
    "allow-set-label",
    "allow-connect-source",
    "allow-open-url",
    "allow-set-zoom",
    "allow-set-pill-scale",
    "allow-set-pill-slots",
    "allow-set-pill-locked",
    "allow-flyout-hover",
    "allow-flyout-pointer",
    "allow-flyout-open-popover",
    "allow-flyout-close",
    "allow-flyout-size"
  ]
}

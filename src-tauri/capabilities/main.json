{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The only window. Events, window dragging and the app's own commands. No fs, shell, http or opener access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "allow-get-snapshot",
    "allow-refresh-now",
    "allow-detect-sources",
    "allow-get-settings",
    "allow-update-settings",
    "allow-connect"
  ]
}
